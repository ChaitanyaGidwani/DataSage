# DataSage Frontend Environment Variables for Vercel / Local

# Base URL for the DataSage FastAPI backend.
# In production on Vercel:
# Option A (Direct): Set to your deployed backend URL, e.g. https://api.datasage.ai/api/v1
# Option B (Proxy Rewrite): Set to /api/v1 and set BACKEND_URL=https://api.datasage.ai
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: Next.js backend rewrite target (avoids CORS in browser)
# BACKEND_URL=https://your-backend-service.com

# Application Brand Display Name
NEXT_PUBLIC_APP_NAME=DataSage
