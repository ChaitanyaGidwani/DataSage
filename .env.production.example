# ==============================================================================
# DataSage — Production Environment Template
# ==============================================================================
# COPY this to .env.production and fill in actual values.
# NEVER commit .env.production to version control.
# ==============================================================================

# --- Application ---
APP_NAME=DataSage
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=WARNING
APP_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# --- Frontend ---
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=DataSage

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=datasage
POSTGRES_USER=datasage
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=40

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=3600

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_128_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (production frontend domain only) ---
CORS_ORIGINS=https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# --- ML ---
ML_MODEL_DIR=/app/ml/models
ML_VALUATION_MODEL_NAME=valuation_xgb_v1.joblib
ML_PREDICTION_CACHE_TTL=86400
ML_MIN_CONFIDENCE_THRESHOLD=0.6

# --- Geospatial ---
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=30
OVERPASS_MAX_RETRIES=3
GEO_DEFAULT_SRID=4326
GEO_SEARCH_RADIUS_METERS=5000

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_ML=20/minute
